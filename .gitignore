
# The Intent runtime store: per-machine, rebuilt from the committed extract.
intent/.cache/

# Intent's store snapshots and text exports: per-machine, never committed.
intent/.backup/

# SwiftPM's build products and Xcode's per-user state, as `swift package init` writes them.
.DS_Store
/.build
/Packages
xcuserdata/
DerivedData/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc

# Backups that intent upgrade writes (.backup/backup-<timestamp>/), never committed.
.backup/backup*

# AGENTS.md regeneration safety net (intent agents sync writes this; transient).
/AGENTS.md.bak

# Per-developer Claude Code settings (paths and tool allowlists vary).
.claude/settings.local.json

# Treeindex cache (derived, machine-local; regenerate with 'intent treeindex <dir>').
intent/.treeindex/

# Secrets, at any depth; an example file may be committed.
.env
.env.*
!.env.example
